{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "nxlink",
      "type": "shell",
      "command": "nxlink",
      "args": [
        "-a",
        "192.168.1.3",
        "${input:targetNro}",
        "-s"
      ],
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "^server active"
        }
      }
    }
  ],
  "inputs": [
    {
      "id": "targetNro",
      "type": "command",
      "command": "extension.commandvariable.remember",
      "args": {
        "key": "selectedNro"
      }
    }
  ]
}